# ==============================================================================
# MOAMLIGHT D2C E-COMMERCE - SHOPIFY STOREFRONT API & SEO CONFIGURATION
# ==============================================================================

# Canonical Website Domain (used for metadata, OpenGraph, sitemap.xml, robots.txt, and JSON-LD)
NEXT_PUBLIC_SITE_URL=https://moamlight.in

# Shopify Store Domain (e.g. "moamlight.myshopify.com")
# When blank or left as placeholder, the system runs in Mock Mode using data/products.ts
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=

# Public Storefront API Access Token (Headless Sales Channel)
# Grants read-only catalog access and customer checkout session creation
NEXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Shopify Storefront GraphQL API Version (defaults to 2024-07)
# Version used by the GraphQL client
SHOPIFY_STOREFRONT_API_VERSION=2024-07

# Webhook Secret for on-demand ISR revalidation (/api/revalidate)
# Used to verify Shopify Admin HMAC-SHA256 signatures on product and collection updates
SHOPIFY_REVALIDATION_SECRET=

# Explicitly force mock data mode even if Shopify credentials are present (true/false)
NEXT_PUBLIC_FORCE_MOCK_DATA=false
